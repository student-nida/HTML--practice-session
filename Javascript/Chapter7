// TOPIC JAVASCRIPT PROMISES
  // resolve();
let promise = new Promise(function(resolve, reject){
    let age = 18;
    if(age>=18){
        resolve("Eligible");
    }else{
        reject("Not Eligible");
    }
});

promise.then(function(result){
    console.log(result);
});

//reject()
let myPromise = new Promise(function(resolve, reject){
    let age = 18;
    if(age<18){
        resolve("Eligible");
    }else{
        reject("Not Eligible");
    }
});

 myPromise.catch(function(error){
    console.log(error);
});


