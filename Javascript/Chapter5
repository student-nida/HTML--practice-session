// Que1:

let arr = [];
let n = Number(prompt("How many number do you want to add? "));

for(let i=0; i<n; i++){
    let num = Number(prompt("Enter the number"));
    arr.push(num);
}

console.log("array:", arr);

// Que2

let arr = [];

while (true) {
    let num = Number(prompt("Enter a number:"));

    if (num === 0) {
        break;
    }

    arr.push(num);
}

console.log("Final Array:", arr);

